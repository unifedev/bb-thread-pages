{
  "name": "@unifedev/thread-pages",
  "version": "1.0.3",
  "description": "Thread Pages for bb: every agent session gets one directly editable HTML page you can read and answer from, on any device.",
  "license": "MIT",
  "author": "Bartosz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unifedev/bb-thread-pages.git"
  },
  "homepage": "https://github.com/unifedev/bb-thread-pages",
  "bugs": {
    "url": "https://github.com/unifedev/bb-thread-pages/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "unife",
    "thread-pages",
    "agents",
    "html"
  ],
  "type": "module",
  "private": false,
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.47"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:runtime && bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run build:runtime && npm run typecheck && npm test"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "^0.4.47",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "bb-app": "0.42.1",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0",
    "zod": "^4.3.6"
  },
  "bb": {
    "name": "Thread Pages",
    "description": "Host one directly editable HTML page per session, served as a site the reader can answer from.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "skills": []
  },
  "files": [
    "server.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/server.js",
    "dist/server.meta.json",
    "README.md",
    "tsconfig.json",
    "package-lock.json"
  ]
}
